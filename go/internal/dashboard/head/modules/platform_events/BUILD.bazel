load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "platform_events",
    srcs = [
        "k8s_provider.go",
        "platform_events.go",
    ],
    importpath = "github.com/ray-project/ray/go/internal/dashboard/head/modules/platform_events",
    visibility = ["//go:__subpackages__"],
    deps = [
        "//go/internal/dashboard/head",
        "//go/pkg/log",
        "//go/proto",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)

go_test(
    name = "platform_events_test",
    srcs = ["platform_events_test.go"],
    embed = [":platform_events"],
    deps = [
        "//go/internal/dashboard/head",
        "//go/proto",
        "@org_golang_google_protobuf//types/known/timestamppb",
    ],
)
